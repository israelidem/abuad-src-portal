node_modules/
.DS_Store

# Environment files — never commit real credentials.
# The .example variants are safe and intentionally tracked.
.env
.env.*
!.env.example
backend/node_modules/
backend/.env
backend/.env.*
# Re-included after the wildcard above, which would otherwise swallow the
# tracked template. Order matters here: the last matching rule wins.
!backend/.env.example
frontend/node_modules/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Build output
frontend/dist/
