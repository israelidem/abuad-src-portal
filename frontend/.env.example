# ============================================================
# ABUAD SRC Portal — Frontend Environment Variables
#
# Copy this to `.env` and fill in real values.
#
# Everything here is bundled into the JavaScript that ships to the
# browser, so treat all of it as public. Only ever use the *anon* key.
# The service-role key must stay in backend/.env.
# ============================================================

# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase → Settings → API → Project API keys → anon / public
# Safe to expose: Row Level Security decides what this key can read.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Where the Express API is listening.
# Must also appear in ALLOWED_ORIGINS in backend/.env, or CORS blocks it.
VITE_API_URL=http://localhost:5000
