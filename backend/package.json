{
  "name": "abuad-src-portal-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "ABUAD SRC Portal — Express API (Supabase + Prisma)",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:dev": "dotenv -e .env -- npx prisma migrate dev",
    "migrate:deploy": "dotenv -e .env -- npx prisma migrate deploy",
    "db:push": "dotenv -e .env -- npx prisma db push",
    "generate": "prisma generate",
    "validate": "dotenv -e .env -- npx prisma validate",
    "studio": "dotenv -e .env -- npx prisma studio",
    "check:db": "node scripts/check-db.mjs",
    "smoke": "node scripts/smoke-routes.mjs",
    "sql:generate": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/sql/00_schema.sql"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.15.0"
  }
}
