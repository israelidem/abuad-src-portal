// ============================================================
// ABUAD SRC Portal — Database Schema
// Postgres (Supabase) + Prisma
//
// NOTE: `Profile.id` mirrors `auth.users.id` from Supabase Auth.
// The foreign key to auth.users is added in a manual SQL migration
// because Prisma does not manage the `auth` schema.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled (pgbouncer) — runtime
  directUrl = env("DIRECT_URL")        // direct connection — migrations
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum UserRole {
  STUDENT
  REP
  ADMIN
  /// The "absolute admin". Outranks ADMIN and is deliberately hard to
  /// remove: a SUPER_ADMIN can only be demoted or deactivated by another
  /// SUPER_ADMIN, and the last one standing cannot be demoted at all.
  /// Without that floor, two admins could lock each other out and leave
  /// the portal with nobody able to restore access.
  SUPER_ADMIN
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketCategory {
  ACADEMIC
  ICT
  INFRASTRUCTURE
  WELFARE
  ADMINISTRATION
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  REOPENED
  RATED
  FLAGGED
  UNFLAGGED
  ATTACHMENT_ADDED
  DUE_DATE_CHANGED
  /// Staff re-routed the ticket to a different department. Without this
  /// the reroute happened silently — the ticket moved office and the
  /// timeline gave the reporter no explanation for the delay.
  DEPARTMENT_CHANGED
}

enum NotificationType {
  TICKET_CREATED
  STATUS_CHANGED
  NEW_COMMENT
  ASSIGNED
  TICKET_RESOLVED
  SLA_BREACH
  ANNOUNCEMENT
  POLL_OPENED
}

// ------------------------------------------------------------
// USERS & ORGANISATION
// ------------------------------------------------------------

model Profile {
  id                  String   @id @db.Uuid // = auth.users.id
  email               String   @unique
  fullName            String?  @map("full_name")
  matricNumber        String?  @unique @map("matric_number")
  faculty             String?
  department          String?
  avatarUrl           String?  @map("avatar_url")
  role                UserRole @default(STUDENT)
  isActive            Boolean  @default(true) @map("is_active")
  emailVerifiedDomain Boolean  @default(false) @map("email_verified_domain")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tickets           Ticket[]           @relation("TicketAuthor")
  assignedTickets   Ticket[]           @relation("TicketAssignee")
  comments          TicketComment[]
  events            TicketEvent[]
  votes             TicketVote[]
  ratings           TicketRating[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  announcements     Announcement[]
  pollVotes         PollVote[]
  savedViews        SavedView[]
  auditLogs         AuditLog[]

  settingsUpdates   AppSettings[]

  /// Which SRC desk this rep/admin staffs — deliberately *not* the
  /// `department` field above, which is the student's own academic
  /// department as free text. Null for students and for staff who handle
  /// everything. SetNull rather than Cascade: removing a department must
  /// not delete the people who worked at it.
  srcDepartmentId String?     @map("department_id") @db.Uuid
  srcDepartment   Department? @relation("DepartmentStaff", fields: [srcDepartmentId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([isActive])
  @@index([srcDepartmentId])
  @@map("profiles")
}

/// SRC offices that tickets are routed to (Welfare, ICT, Academic...)
model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  /// Lets one dropdown answer two questions. Students used to pick both a
  /// category and a department — near-duplicate lists — so the form now
  /// asks only for the department and the API derives the category from
  /// here. Keeps category-based reporting working, and a new desk can be
  /// added from the database without touching the enum.
  category TicketCategory @default(OTHER)

  tickets Ticket[]
  /// Reps and admins who staff this desk.
  staff   Profile[] @relation("DepartmentStaff")

  @@map("departments")
}

// ------------------------------------------------------------
// TICKETS
// ------------------------------------------------------------

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  /// Human-readable ID, e.g. SRC-000142 — generated from a Postgres sequence
  ticketNumber String         @unique @default(dbgenerated("public.next_ticket_number()")) @map("ticket_number")

  /// Always populated, even for anonymous tickets (abuse prevention).
  /// Identity is stripped at the API layer when `isAnonymous` is true.
  authorId     String         @map("author_id") @db.Uuid
  author       Profile        @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  isAnonymous  Boolean        @default(false) @map("is_anonymous")

  faculty      String
  category     TicketCategory
  description  String
  urgency      Urgency        @default(MEDIUM)
  status       TicketStatus   @default(PENDING)

  locationText String         @map("location_text")
  locationLat  Float?         @map("location_lat")
  locationLng  Float?         @map("location_lng")

  departmentId String?        @map("department_id") @db.Uuid
  departmentRef Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignedToId String?        @map("assigned_to_id") @db.Uuid
  assignedTo   Profile?       @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// SLA target, derived from urgency on creation
  dueAt        DateTime?      @map("due_at")
  resolvedAt   DateTime?      @map("resolved_at")
  closedAt     DateTime?      @map("closed_at")

  /// Denormalised counters kept in sync by triggers (fast sorting)
  upvoteCount  Int            @default(0) @map("upvote_count")
  commentCount Int            @default(0) @map("comment_count")

  isPublic     Boolean        @default(true) @map("is_public")
  isFlagged    Boolean        @default(false) @map("is_flagged")
  flagReason   String?        @map("flag_reason")

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  attachments TicketAttachment[]
  comments    TicketComment[]
  events      TicketEvent[]
  votes       TicketVote[]
  rating      TicketRating?

  @@index([status])
  @@index([category])
  @@index([urgency])
  @@index([authorId])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([createdAt])
  @@index([upvoteCount])
  @@index([dueAt])
  @@index([isPublic, status])
  @@map("tickets")
}

/// Images live in Supabase Storage — only paths are stored here.
model TicketAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  storagePath String   @map("storage_path")
  thumbPath   String?  @map("thumb_path")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  author     Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  /// Staff-only note — never serialised to students
  isInternal Boolean  @default(false) @map("is_internal")
  isEdited   Boolean  @default(false) @map("is_edited")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

/// Immutable audit timeline: "Pending → In Progress by Rep. Ada, 12 Mar"
model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?         @map("actor_id") @db.Uuid
  actor     Profile?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      TicketEventType
  fromValue String?         @map("from_value")
  toValue   String?         @map("to_value")
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

/// "I'm affected too" — the unique constraint does the heavy lifting
model TicketVote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_votes")
}

model TicketRating {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @unique @map("ticket_id") @db.Uuid
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int // 1..5 — CHECK constraint added in SQL migration
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ticket_ratings")
}

// ------------------------------------------------------------
// NOTIFICATIONS (in-app bell + Web Push)
// ------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// Client-side route to open when clicked
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

/// Web Push (VAPID) subscriptions — one row per browser/device
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

// ------------------------------------------------------------
// ANNOUNCEMENTS & POLLS
// ------------------------------------------------------------

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  author      Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String
  isPinned    Boolean   @default(false) @map("is_pinned")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  polls Poll[]

  @@index([publishedAt])
  @@map("announcements")
}

model Poll {
  id             String        @id @default(uuid()) @db.Uuid
  announcementId String?       @map("announcement_id") @db.Uuid
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  question       String
  closesAt       DateTime?     @map("closes_at")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")

  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid()) @db.Uuid
  pollId    String @map("poll_id") @db.Uuid
  poll      Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  voteCount Int    @default(0) @map("vote_count")
  position  Int    @default(0)

  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @map("poll_id") @db.Uuid
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String     @map("option_id") @db.Uuid
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([pollId, userId]) // one vote per poll per user
  @@map("poll_votes")
}

// ------------------------------------------------------------
// PREFERENCES, SETTINGS & AUDIT
// ------------------------------------------------------------

/// Saved filter combinations for the search overhaul
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_views")
}

/// Single-row table (id is pinned to 1 by a CHECK constraint).
/// Portal settings, editable from the admin UI.
///
/// Every field here is described once in
/// backend/src/config/settingsRegistry.js, which derives the validator, the
/// fallback defaults, the publicly-readable subset and the admin form. Add
/// a column here AND an entry there, or the setting will not be editable.
///
/// The registry also records which file enforces each setting: a setting
/// nothing reads is worse than no setting, because it tells an
/// administrator they have changed something when they have not.
model AppSettings {
  id                    Int      @id @default(1)

  /// Identity. Shown pre-sign-in, so both are publicly readable.
  portalName            String   @default("ABUAD SRC Portal") @map("portal_name")
  supportEmail          String?  @map("support_email")

  restrictSignupDomains Boolean  @default(false) @map("restrict_signup_domains")
  allowedDomains        String[] @default([]) @map("allowed_domains")
  allowSubdomains       Boolean  @default(true) @map("allow_subdomains")
  blockedDomains        String[] @default([]) @map("blocked_domains")

  /// Maintenance mode. When on, students get a 503 with `maintenanceMode:
  /// true` on every write; staff keep working so they can finish or verify
  /// whatever the maintenance is for. Reads stay open — a read-only portal
  /// is far more useful during a migration than a wall.
  maintenanceMode       Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage    String?  @map("maintenance_message")

  /// Registration control. When off, POST /api/auth/signup returns 403 and
  /// the registration page says so. Login and existing accounts are
  /// untouched — this gates account *creation* only, so turning it off
  /// can never lock out staff or current students.
  allowStudentSignups   Boolean  @default(true) @map("allow_student_signups")
  signupClosedMessage   String?  @map("signup_closed_message")

  /// When on, a matric number is mandatory at signup. Defaults off so a
  /// settings read failure cannot start rejecting registrations.
  requireMatricNumber   Boolean  @default(false) @map("require_matric_number")

  /// Anonymous feedback. Turning this off applies to NEW tickets only —
  /// tickets already filed anonymously stay anonymous, because revealing
  /// an author retroactively would break the promise they filed under.
  allowAnonymousTickets Boolean  @default(true) @map("allow_anonymous_tickets")

  /// Attachment ceiling per ticket. A CHECK constraint keeps this in 1..10
  /// at the database level, so a direct connection cannot set 0 (silently
  /// disabling uploads) or something absurd.
  maxAttachmentsPerTicket Int    @default(5) @map("max_attachments_per_ticket")

  updatedById           String?  @map("updated_by_id") @db.Uuid
  updatedBy             Profile? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
