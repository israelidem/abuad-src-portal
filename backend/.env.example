# ============================================================
# ABUAD SRC Portal — Backend Environment Variables
#
# Copy this to `.env` and fill in real values:
#   cp backend/.env.example backend/.env
#
# NEVER commit the real `.env` — it's in .gitignore for a reason.
# This file is the tracked template; keep placeholders only.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only. Bypasses Row Level Security entirely — if this leaks into
# the browser bundle, every table is readable by anyone. It belongs here
# and nowhere else.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Database (Settings → Database → Connection string) ---
#
# [password] is the DATABASE password, not your Supabase account login.
# Reset it under Settings → Database if unsure. Stick to letters and
# numbers: anything in @ # $ % / : ? must be percent-encoded or the URL
# silently fails to parse.
#
# Pooled connection (transaction mode, port 6543) for runtime queries.
# The query string is required, not decoration:
#   pgbouncer=true      prepared statements are unsupported by the pooler
#   connection_limit=1  one per instance; the pooler handles fan-out
#   connect_timeout=30  tolerates free-tier projects waking from idle
# Omitting pgbouncer=true produces a misleading
# "Can't reach database server" that looks like a network fault.
DATABASE_URL=postgresql://postgres.xxxxx:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30

# Session-mode pooler (port 5432) — migrations and long-lived connections.
# Prisma uses this for `migrate`, which the transaction pooler can't serve.
DIRECT_URL=postgresql://postgres.xxxxx:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- CORS ---
# Comma-separated. Exact origins, no trailing slash, or the browser blocks
# every request. This is the one comma-separated variable in the project —
# VITE_API_URL in the frontend is a single URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Web Push (VAPID) ---
# Generate a pair with:  npx web-push generate-vapid-keys
#
# Both keys stay on the server. The browser needs the public key, but it
# fetches it from GET /api/notifications/vapid-public-key at runtime —
# there is deliberately no VITE_ copy to drift out of sync.
#
# Leaving these blank is supported: pushService logs a warning and the
# feature no-ops rather than crashing the API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:src@abuad.edu.ng
