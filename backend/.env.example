# ============================================================
# ABUAD SRC Portal — Backend Environment Variables
#
# Copy this to `.env` and fill in real values.
# NEVER commit the real `.env` to git — it's already in .gitignore.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Supabase
# Get these from: Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # SECRET — backend only!

# Database (Supabase → Settings → Database → Connection string)
#
# The [password] here is the DATABASE password, which is separate from your
# Supabase account login. Reset it under Settings → Database if unsure.
# Stick to letters and numbers — anything in @ # $ % / : ? must be
# percent-encoded or the URL won't parse.
#
# Pooled connection (transaction mode, port 6543) — for runtime queries.
# The query string is required, not optional:
#   pgbouncer=true      disables prepared statements (unsupported by the pooler)
#   connection_limit=1  one connection per instance; the pooler handles fan-out
#   connect_timeout=30  tolerates free-tier projects waking from idle
# Without pgbouncer=true you get a misleading "Can't reach database server".
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&sslmode=require

# Session-mode pooler (port 5432) — for migrations and long-lived connections.
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Web Push (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
# Public key goes in frontend/.env too
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
